node_modules/
build/
dist/
coverage/
.playwright-mcp/
test-results/
playwright-report/
blob-report/
.DS_Store
*.log

# ---- Secrets & per-machine state: NEVER commit ----
# Provider API keys live in .env.local or data/ai-keys.json (server-side store, audit #3).
.env*
!.env.example
# Per-session auth token the API server writes on boot.
.studio-api-token
# Server-side AI provider key store + other runtime data (harvested schemas, caches).
data/*
!data/known_fixes.json
# Per-machine paths (game install, schema folder) written by the Settings modal.
# Copy config.example.json to config.json or just use the in-app Settings.
config.json

# ---- Local caches / generated state ----
.studio-cache/
.snapshots/
# B2s3: persisted active/parked workspace state (per-machine runtime data).
.studio-state/
*.db
.tmp_*
temp_import/
temp_package_test.json

test_generate_api.py

# ---- Working docs & agent notes (kept out of version control by request) ----
dev-docs/

# ---- Cowork session artifacts (kept out of version control by request) ----
# Draft Cowork skills (install via Settings > Capabilities, not committed).
forge-skills/
tests/e2e/handoff-gap-analysis.spec.ts
.kilo/plans/gap-analysis-roadmap-realignment.md

# generated lint artifacts
.lint-*.json

# ---- graphify knowledge graph (regenerable via `graphify update .`) ----
# ~2.3MB of generated graph.json/graph.html/report — rebuild anytime, don't commit.
# (.graphifyignore stays tracked; the AGENTS/CLAUDE/GEMINI.md instruction files do too.)
graphify-out/

# Vite uses public-assets/ explicitly. Legacy public/ was validation scratch and
# once carried real mod payloads; keep it from returning as a release leak.
public/
